# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=xfce4-session
pkgver=4.21.0
pkgrel=2
pkgdesc="Session manager for Xfce"
url="https://xfce.org/"
arch="all"
license="GPL-2.0-or-later"
subpackages="$pkgname-doc $pkgname-lang"
depends="hicolor-icon-theme"
makedepends="
	gtk-layer-shell-dev
	intltool
	libxfce4ui-dev
	libxfce4util-dev
	libxfce4windowing-dev
	xfce4-panel-dev
	gtk3-dev
	xfce4-dev-tools
	xfconf-dev
	meson
	"
source="https://archive.xfce.org/src/xfce/xfce4-session/${pkgver%.*}/xfce4-session-$pkgver.tar.xz
       disable-x11-session-settings.patch 
       0001-Fix-logout-shutdown-and-restart.patch
	"

build() {
	abuild-meson \
	    -Dx11=disabled \
	    -Dwayland=enabled \
	    . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	cat > "$pkgdir"/usr/bin/xfce4-wayland <<-EOF
		#!/bin/sh
		exec dbus-launch startxfce4 --wayland
	EOF
	chmod +x "$pkgdir"/usr/bin/xfce4-wayland
}


